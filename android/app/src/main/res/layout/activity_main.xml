<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ember_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ember_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_bridge_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NOVA Bridge · :8765"
            android:textColor="@color/ember_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_accessibility"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/ember_border"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/enable_accessibility"
            android:textAllCaps="false"
            android:textColor="@color/ember_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_toggle_url"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="@color/ember_border"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="URL"
            android:textAllCaps="false"
            android:textColor="@color/ember_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/url_bar_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ember_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_server_url"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/ember_bg"
            android:hint="@string/server_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/ember_text"
            android:textColorHint="@color/ember_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_connect_url"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/ember_accent"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/connect_server"
            android:textAllCaps="false"
            android:textColor="#21110A"
            android:textSize="12sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ember_bg" />

</LinearLayout>
